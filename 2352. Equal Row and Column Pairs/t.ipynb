   "source": [
    "class Solution:\n",
    "    def equalPairs(self, grid: List[List[int]]) -> int:\n",
    "        straight = Counter(map(tuple,grid))\n",
    "        gay = Counter(zip(*grid))\n",
    "        \n",
    "        return sum(straight[t]*gay[t] for t in straight)"
   ]
  }
